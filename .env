# 淘汰策略，支持 LRU 或 LFU
EVICTION_POLICY=LFU

# 网络监听地址和端口
SERVER_ADDR=0.0.0.0:6380

# AOF 存储路径
AOF_FILE_PATH=database.aof

# Lua 多线程虚拟机的数量 (根据 CPU 核心数调整)
LUA_WORKER_COUNT=8

# Lua 任务队列深度
LUA_QUEUE_DEPTH=100000

# Lua 环境对象池大小
LUA_VM_POOL_SIZE=50

# 全局 Hash 分片数量 (推荐 2 的幂次方，如 64, 128)
NUM_SHARDS=64

# AOF 刷盘策略: 
# Always   - 每次写入强制落盘，绝对安全，性能极低 (受限于磁盘 IOPS)
# EverySec - 每秒后台强制落盘一次，性能高，最多丢失1秒数据 (推荐默认)
# No       - 交给操作系统内核管理落盘，极致狂飙，断电会丢失数据
AOF_FSYNC=EverySec
